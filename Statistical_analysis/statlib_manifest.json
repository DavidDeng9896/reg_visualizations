{
  "name": "statlib",
  "version": "1.0.0",
  "description": "AI 统计分析算法库：20 个方法，纯计算、JSON 可序列化、固定种子可复现",
  "integration": {
    "entry": "import statlib; result = statlib.run(method, params, data)",
    "result_schema": "{\"method\", \"stats\": {..., \"interpretation\": str}, \"params\", \"data\"}",
    "available_methods": "statlib.available()"
  },
  "methods": [
    {
      "method": "nonlinear_regression",
      "module": "statlib.xy_nonlinear",
      "doc": "曲线拟合（4PL/5PL/MM/指数衰减），提取 IC50/Vmax/Km",
      "skill": "stat-nonlinear-regression",
      "dependencies": [
        "lmfit",
        "scipy",
        "statsmodels"
      ],
      "params": {
        "model": {
          "default": "four_pl",
          "description": "模型: four_pl/three_pl/five_pl/mm/exp_decay",
          "regenerates_data": false
        },
        "weighting": {
          "default": "equal",
          "description": "权重: equal/1/y/1/y2/y/y2",
          "regenerates_data": false
        },
        "robust": {
          "default": false,
          "description": "稳健回归 soft_l1",
          "regenerates_data": false
        },
        "compare": {
          "default": false,
          "description": "是否输出 AICc 模型比较表",
          "regenerates_data": false
        },
        "data:n_points": {
          "default": 9,
          "description": "浓度点数",
          "regenerates_data": true
        },
        "data:reps": {
          "default": 3,
          "description": "复孔数",
          "regenerates_data": true
        }
      },
      "reference_page": "pages/xy_nonlinear.py",
      "call_example": "import statlib; result = statlib.run(\"nonlinear_regression\", params, data)"
    },
